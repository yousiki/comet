{
  // Zeron edge: per-session + legacy workspace-document sync DOs, per-device
  // relay DOs, R2 blobs, and the absorbed WorkOS auth routes.
  // Design: loro-sessions §2 (topology), §3 (persistence), §6.1 (diff
  // sidecar), §8 (device-room streams), §1.2 (R2 attachments), §3.3 (R2
  // backups); ARCHITECTURE.md §6.
  // NOTE: the worker name and R2 bucket names keep the historical "comet"
  // prefix on purpose — Durable Object storage is bound to the script name,
  // so renaming the worker would orphan every session/registry/chat room.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed by .github/workflows/deploy.yml on pushes to main that touch
  // edge/ (CLOUDFLARE_API_TOKEN repo secret).
  "name": "comet-native-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // This fork deploys to YouSiki's Cloudflare account (was upstream
  // b57dde68ee5964dccc025437b5478a5b on the zeron.sh zone).
  "account_id": "3ba1aaf889ad9e15eebee459ff361919",
  "workers_dev": true,
  // Public hostname on the siki.moe zone. (Upstream carved install.sh and
  // /releases/* out of its landing zone; this fork exposes them on the same
  // edge host — the installer URL is https://edge.siki.moe/install.sh.)
  "routes": [{ "pattern": "edge.siki.moe", "custom_domain": true }],
  // Serve src/install.sh as a string (the /install.sh route).
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  // loro-crdt's default entry loads its WASM via URL fetch, which workerd
  // cannot do at runtime; the base64 entry inlines the module instead.
  "alias": {
    "loro-crdt": "loro-crdt/base64"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_ROOMS", "class_name": "SessionRoom" },
      { "name": "DEVICE_ROOMS", "class_name": "DeviceRoom" },
      { "name": "REGISTRY_ROOMS", "class_name": "RegistryRoom" },
      { "name": "CHAT_ROOMS", "class_name": "ChatRoom" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom", "DeviceRoom"]
    },
    {
      // Organization registry (docs/registry-sync.md) — row-table sidebar
      // sync replacing the legacy Loro workspace-document rooms.
      "tag": "v2",
      "new_sqlite_classes": ["RegistryRoom"]
    },
    {
      // chat2 session rooms (docs/chat2-sync.md) — dumb log relays that
      // replace SessionRoom's loro-aware s2 rooms.
      "tag": "v3",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "comet-native-blobs"
    },
    {
      // Release artifacts for /releases/* (curl-install + dmg downloads).
      "binding": "RELEASES",
      "bucket_name": "comet-native-releases"
    }
  ],
  "vars": {
    // WorkOS AuthKit client id (this fork's own WorkOS environment) — JWTs
    // verified against its JWKS. Set AUTH_MODE=dev locally to accept
    // bearer==userId. WORKOS_API_KEY is a wrangler secret
    // (`wrangler secret put WORKOS_API_KEY`) powering the /auth/* routes.
    "WORKOS_CLIENT_ID": "client_01M09AJF16TCBRA7H3BJC9PXEB",
    "AUTH_MODE": "workos"
  },
  "observability": {
    "enabled": true
  }
}
